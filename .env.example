# nz-roof-solar environment configuration.
#
# Copy this file to .env and fill in your values:
#     cp .env.example .env
#
# .env is git-ignored. The tools read LINZ_API_KEY from the environment; export
# it yourself (e.g. `set -a; . ./.env; set +a`) or load it in your shell.

# === Required ===
# LINZ Data Service API key, used for the NZ Building Outlines WFS request.
# Create one at https://linz.data.govt.nz/ (account > API keys).
LINZ_API_KEY=
